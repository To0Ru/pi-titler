{
  "name": "pi-titler",
  "version": "0.1.0",
  "type": "module",
  "description": "Smart, CJK-aware automatic session naming for the Pi coding agent using customizable lightweight models",
  "main": "extensions/index.ts",
  "files": ["extensions", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "engines": { "node": ">=22.19.0" },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "session",
    "auto-title",
    "session-name"
  ],
  "author": "To0Ru",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/To0Ru/pi-titler.git"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2"
  }
}
